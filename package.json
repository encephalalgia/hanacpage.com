{
  "name": "amelliya.com",
  "type": "module",
  "version": "1.0.2",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "postbuild": "npx -y pagefind --site dist/client && gzipper compress dist/client/pagefind --include=css,js --gzip --gzip-level 9 --brotli --brotli-quality 11",
    "preview": "astro preview",
    "astro": "astro",
    "test:html": "html-validate \"dist/client/**/*.html\"",
    "test:links": "linkinator http://localhost:4321 --recurse",
    "test:a11y": "pa11y-ci --sitemap http://localhost:4321/sitemap-index.xml --sitemap-find https://www.amelliya.com --sitemap-replace http://localhost:4321",
    "test:all": "npm run test:html && npm run test:links && npm run test:a11y"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^13.5.5",
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "@expressive-code/plugin-line-numbers": "^0.43.1",
    "astro": "https://pkg.pr.new/astro@b57dafd",
    "astro-compressor": "^1.3.0",
    "astro-expressive-code": "^0.43.1",
    "astro-og-canvas": "^0.11.1",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "gzipper": "^8.3.0",
    "html-validate": "^11.6.0",
    "linkinator": "^8.0.2",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "semantic-release": "^25.0.8",
    "wait-on": "^9.1.0"
  }
}
